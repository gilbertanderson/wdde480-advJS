<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="index.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Let iisnode's log viewer through at /iisnode/index.html -->
        <rule name="LogFile" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^iisnode" />
        </rule>
        <rule name="NodeApp">
          <match url="/*" />
          <action type="Rewrite" url="index.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- Never serve dependencies or config/config.env as static files -->
          <add segment="node_modules" />
          <add segment="config" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- Pass the app's own error responses through instead of IIS's generic 500 page -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
